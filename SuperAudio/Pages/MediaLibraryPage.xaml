<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperAudio.Pages.MediaLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperAudio.Pages"
    xmlns:viewModel="using:SuperAudio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" MaxWidth="1064">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
            Margin="36,24,36,24"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            x:Uid="MediaLibraryPageTitle"/>
        <ScrollView
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 工具栏 -->
                        <RowDefinition Height="*"/>
                        <!-- 文件列表 -->
                    </Grid.RowDefinitions>

                    <!-- 工具栏：返回上级 + 地址栏 -->
                    <!-- 工具栏：使用 StackPanel 包裹，更灵活 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Spacing="4">
                        <!-- 把 CommandBar 的样式改得更紧凑 -->
                        <CommandBar DefaultLabelPosition="Right" 
                            Background="Transparent"
                            MinHeight="40"
                            Padding="0">
                            <CommandBar.PrimaryCommands>
                                <!-- 返回上级 -->
                                <AppBarButton Icon="Up" 
                          Command="{x:Bind ViewModel.GoUpCommand}"
                          ToolTipService.ToolTip="返回上一级" />
                                <!-- 刷新按钮：从 Secondary 移到 Primary，直接显示 -->
                                <AppBarButton Icon="Refresh" 
                          Command="{x:Bind ViewModel.RefreshCommand}"
                          ToolTipService.ToolTip="刷新" />
                            </CommandBar.PrimaryCommands>

                            <!-- 地址栏作为 Content，占据剩余空间 -->
                            <CommandBar.Content>
                                <TextBox x:Name="AddressBar" 
                                     Text="{x:Bind ViewModel.CurrentPath, Mode=TwoWay}"
                                     MinWidth="200"
                                     Width="Auto"
                                     VerticalAlignment="Center"
                                     KeyDown="OnAddressBarKeyDown"
                                     PlaceholderText="输入路径..."
                                     Margin="8,0,0,0" />
                            </CommandBar.Content>
                        </CommandBar>
                    </StackPanel>

                    <!-- 文件/文件夹列表 -->
                    <ListView x:Name="FileListView" 
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.FileItems, Mode=OneWay}"
                      SelectionMode="Multiple">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="MenuItem_Play" AccessKey="P" FontWeight="Bold"></MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="MenuItem_PlayWithSystemPlayer" AccessKey="P"></MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="MenuItem_FindInExplorer" AccessKey="F"></MenuFlyoutItem>
                                
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModel:FileItem">
                                <Grid Padding="4" Background="Transparent" DoubleTapped="OnItemDoubleTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 图标 -->
                                    <SymbolIcon Symbol="{x:Bind Icon}"  x:Name="ItemIcon"
                                        Margin="0,0,12,0" 
                                        VerticalAlignment="Center"/>
                                    <!-- 名称 -->
                                    <TextBlock Grid.Column="1" 
                                       Text="{x:Bind DisplayName}" 
                                       VerticalAlignment="Center"/>
                                    <!-- 修改日期（可选） -->
                                    <TextBlock Grid.Column="2" 
                                       Text="{x:Bind DateModified}" 
                                       Opacity="0.6" 
                                       Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </ScrollView>
    </Grid>
</Page>
