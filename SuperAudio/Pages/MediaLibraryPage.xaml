<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperAudio.Pages.MediaLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperAudio.Pages"
    xmlns:converters="using:SuperAudio.Converters"
    xmlns:viewModel="using:SuperAudio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:StringCompareToBooleanConverter x:Name="StringCompareToBooleanConverter"/>
    </Page.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
             MaxWidth="1064"
            Margin="36,24,36,24"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            x:Uid="MediaLibraryPageTitle"/>

        <Grid Grid.Row="1" MaxWidth="1064">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 工具栏 -->
                <RowDefinition Height="*"/>
                <!-- 文件列表 -->
            </Grid.RowDefinitions>

            <!-- 工具栏：返回上级 + 地址栏 -->
            <!-- 工具栏：使用 StackPanel 包裹，更灵活 -->
                <!-- 把 CommandBar 的样式改得更紧凑 -->
            <CommandBar Background="Transparent" x:Name="MyCommandBar"
                        Padding="0" HorizontalContentAlignment="Stretch" Grid.Row="0">
                <CommandBar.Content>
                    <Grid  Width="{Binding ElementName=MyCommandBar, Path=ActualWidth}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 返回上级按钮（Up），放在地址栏左侧 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <AppBarButton Icon="Home" Command="{x:Bind ViewModel.GoHomeCommand}" LabelPosition="Collapsed"/>
                                <AppBarButton
                                            Icon="Up" 
                                            Command="{x:Bind ViewModel.GoUpCommand}"
                                            x:Uid="GoUpCommand"
                                          
                                            LabelPosition="Collapsed"
                                            />
                                <AppBarButton Icon="Refresh" 
                                            Command="{x:Bind ViewModel.RefreshCommand}"
                                            x:Uid="RefreshCommand" LabelPosition="Collapsed"/>
                                <SplitButton>
                                    <FontIcon Glyph="&#xE71C;"></FontIcon>
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                        <RadioMenuFlyoutItem
                                            GroupName="Filter"
                                            IsChecked="{x:Bind ViewModel.Filter,Mode=OneWay,Converter={StaticResource StringCompareToBooleanConverter},ConverterParameter=All}" Command="{x:Bind ViewModel.FilterSwichCommand}" CommandParameter="All"
                                            x:Uid="MediaFilter_All"></RadioMenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <RadioMenuFlyoutItem 
                                            GroupName="Filter" 
                                            IsChecked="{x:Bind ViewModel.Filter,Mode=OneWay,Converter={StaticResource StringCompareToBooleanConverter},ConverterParameter=Audio}" Command="{x:Bind ViewModel.FilterSwichCommand}" CommandParameter="Audio"
                                            x:Uid="MediaFilter_Audio"></RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem 
                                            GroupName="Filter"
                                            IsChecked="{x:Bind ViewModel.Filter,Mode=OneWay,Converter={StaticResource StringCompareToBooleanConverter},ConverterParameter=Video}" Command="{x:Bind ViewModel.FilterSwichCommand}" CommandParameter="Video"
                                            x:Uid="MediaFilter_Video"></RadioMenuFlyoutItem>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                            </StackPanel>
                            <!-- 地址栏文本框，填充剩余宽度，直接设置外观样式 -->
                        <TextBox Grid.Column="1"
                                            x:Name="AddressBar"
                                            Text="{x:Bind ViewModel.CurrentPath, Mode=TwoWay}"
                                            MinWidth="250"
                                            VerticalAlignment="Center"
                                            KeyDown="OnAddressBarKeyDown"
                                            x:Uid="CurrentPath"
                                            PlaceholderText="输入路径..."
                                         
                                            FontSize="14" />
                    </Grid>
                </CommandBar.Content>
            </CommandBar>
                
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <!-- 文件/文件夹列表 -->
                <ListView x:Name="FileListView" 
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.FileItems, Mode=OneWay}"
                  SelectionChanged="FileListView_SelectionChanged"
                  SelectionMode="Multiple">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="MenuItem_Play" AccessKey="P" FontWeight="Bold" Command="{x:Bind ViewModel.PlayCommand}"></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MenuItem_PlayWithSystemPlayer" AccessKey="P" Command="{x:Bind ViewModel.PlayWithSystemPlayerCommand}"></MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="MenuItem_FindInExplorer" AccessKey="F" Command="{x:Bind ViewModel.OpenFileInExplorerCommand}"></MenuFlyoutItem>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModel:FileItem">
                            <Grid Padding="4" Background="Transparent" DoubleTapped="OnItemDoubleTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 图标 -->
                                <SymbolIcon Symbol="{x:Bind Icon}"  x:Name="ItemIcon"
                                    Margin="0,0,12,0" 
                                    VerticalAlignment="Center"/>
                                <!-- 名称 -->
                                <TextBlock Grid.Column="1" 
                                   Text="{x:Bind DisplayName}" 
                                   VerticalAlignment="Center"/>
                                <!-- 修改日期（可选） -->
                                <TextBlock Grid.Column="2" 
                                   Text="{x:Bind DateModified}" 
                                   Opacity="0.6" 
                                   Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
               
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
