<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperAudio.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperAudio.Pages"
    xmlns:converters="using:SuperAudio.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <converters:PathToMediaSourceConverter x:Key="PathConverter" />
        <converters:FileExtensionConverter x:Key="FileExtensionConverter" />
    </Page.Resources>
    <Grid >
        <!-- 隐藏播放器 -->
        <MediaPlayerElement x:Name="PlayerElement" 
                            Visibility="Visible" 
                            AutoPlay="True"
                            Source="{x:Bind ViewModel.CurrentItem.FullPath, Converter={StaticResource PathConverter}}" />

        <!-- 主布局 -->
        <Grid VerticalAlignment="Center" 
              HorizontalAlignment="Center" 
              MaxWidth="500" 
              Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 封面（根据文件类型显示不同图标） -->
            <Border Grid.Row="0" x:Name="CoverBorder"
                    Width="220" Height="220" 
                    CornerRadius="16" 
                    Margin="0,0,0,24"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                <!-- 绑定到 FileItem.Icon，让封面图标与列表一致 -->
                <SymbolIcon x:Name="CoverIcon"
                            Symbol="{x:Bind ViewModel.CurrentItem.Icon}" 
                            Width="72" Height="72" 
                            Opacity="0.5"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
            </Border>

            <!-- 2. 文件名（大号） -->
            <TextBlock Grid.Row="1" 
                       Text="{x:Bind ViewModel.CurrentItem.DisplayName}" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,6"/>

            <!-- 3. 文件类型/大小（用扩展名模拟"艺术家"） -->
            <TextBlock Grid.Row="2" 
                       Text="{x:Bind ViewModel.CurrentItem.FullPath, Converter={StaticResource FileExtensionConverter}}" 
                       FontSize="16" 
                       Opacity="0.6"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- 4. 进度条 + 时间 -->
            <StackPanel Grid.Row="3" 
                        Orientation="Vertical" 
                        Width="360">
                <Slider Minimum="0" 
                        Maximum="100" 
                        Value="0"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="00:00" 
                               FontSize="14" 
                               Opacity="0.6"/>
                    <TextBlock Grid.Column="2" 
                               Text="00:00" 
                               FontSize="14" 
                               Opacity="0.6" 
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- 5. 控制按钮 -->
            <StackPanel Grid.Row="4" 
                        Orientation="Horizontal" 
                        Spacing="12" 
                        Margin="0,20,0,0">
                <AppBarButton Icon="Shuffle" />
                <AppBarButton Icon="Previous" />
                <AppBarButton>
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE102;" 
                                  FontFamily="Segoe MDL2 Assets" 
                                  FontSize="28"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="Next" />
                <AppBarButton Icon="RepeatAll" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>